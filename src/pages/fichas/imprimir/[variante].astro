---
// Todas las fichas para imprimir: 1 hoja de reglas + 1 hoja A4 por héroe con los 5 niveles a la vista. Se convierte en PDF con scripts/generar-pdfs.sh.
import Base from '../../../layouts/Base.astro';
import { clases, DINERO_TEXTO, alcanceTexto, SUMINISTROS, equipoTexto, TALENTOS, SUMA, EXTRA_DANO, NIVELES, RANGO_TEXTO, USO_TEXTO, suma, vida, defensa, extraDano, ataqueArma } from '../../../data/clases';
const mas = (n: number) => `+${n}`;
const mejora = ['Empiezas', '+1 daño, más vidas', 'Poder nuevo, más sumas', 'Defensa +1', 'Superpoder, más sumas'];

// Tres versiones: con el héroe chico, con la heroína chica, y con un cuadro vacío para que el niño dibuje a su héroe.
export function getStaticPaths() {
  return [
    { params: { variante: 'chico' }, props: { v: 'chico', titulo: 'con héroe chico' } },
    { params: { variante: 'chica' }, props: { v: 'chica', titulo: 'con heroína chica' } },
    { params: { variante: 'dibujo' }, props: { v: 'dibujo', titulo: 'para dibujar tu héroe' } },
  ];
}
const { v, titulo } = Astro.props;
const todas = [['chico', '🧑 Chico'], ['chica', '👩 Chica'], ['dibujo', '✏️ Para dibujar']];
---
<Base titulo={`Fichas de héroe para imprimir (${titulo})`} descripcion="Las 10 fichas de héroe del Gremio, una hoja A4 por héroe con los cinco niveles y el dinero inicial, más la hoja de reglas." clase="fichas-pag fichas-imp">
  <section>
    <p class="meta no-imprimir"><a href="/fichas/">← fichas</a></p>
    <div class="fila no-imprimir" style="margin-bottom:20px">
      <button class="boton" type="button" data-imprimir>🖨️ Imprimir o guardar en PDF</button>
      <a class="boton fantasma" href={`/descargas/fichas-de-heroe-${v}.pdf`} download>📄 Descargar el PDF</a>
      {todas.filter(([x]) => x !== v).map(([x, n]) => <a class="boton fantasma" href={`/fichas/imprimir/${x}/`}>{n}</a>)}
    </div>

    <div class="fi-hoja fi-reglas">
      <h1>Fichas de héroe · reglas del Gremio</h1>
      <h2>Cómo se juega en 6 pasos</h2>
      <ol class="reglas-lista">
        <li><strong>Un dado para todo.</strong> Cuando quieras hacer algo difícil, el master te dice qué habilidad usar. Tira un d20 y <strong>suma el número de esa habilidad en tu ficha</strong>.</li>
        <li><strong>¿Llegas?</strong> El master dice una dificultad (5 fácil, 10 normal, 15 difícil, 20 heroico). Si igualas o superas, ¡lo consigues!</li>
        <li><strong>Atacar.</strong> d20 + el número de tu arma. Si igualas o superas la <em>Defensa</em> del enemigo, le das. Entonces tira el dado del arma y <strong>suma tu extra de daño</strong>. Quita esa cantidad a sus vidas. <strong>Alcance:</strong> cuerpo a cuerpo, el enemigo debe estar a tu lado; a distancia, hasta las casillas que pone tu arma (el doble con desventaja).</li>
        <li><strong>Un 20 es crítico, un 1 es pifia.</strong> Con un 20 tiras el dado del arma dos veces. Con un 1, ¡algo gracioso sale mal!</li>
        <li><strong>Tu turno.</strong> Te mueves y haces una cosa: atacar, usar un poder, ayudar, esconderte, curar… Si un amigo te ayuda, tiras dos d20 y te quedas con el más alto.</li>
        <li><strong>Vidas.</strong> A 0 vidas te quedas dormido: un amigo te despierta con cuidados, o al acabar el combate vuelves con 1 vida. Descanso corto (1 h): recuperas la mitad; largo (8 h): todas.</li>
      </ol>
      <h2>¿Qué habilidad uso?</h2>
      <table class="tabla-sencilla">
        <tbody>{TALENTOS.map((t) => <tr><td><strong>{t.emoji} {t.nombre}</strong></td><td>{t.sirve}</td></tr>)}</tbody>
      </table>
      <h2>Lo que sumas según lo bueno que seas</h2>
      <table class="tabla-sencilla">
        <thead><tr><th>Eres…</th>{NIVELES.map((n) => <th>Nivel {n}</th>)}</tr></thead>
        <tbody>
          {(['fuerte', 'bueno', 'normal', 'flojo'] as const).map((r) => <tr><td><strong>{RANGO_TEXTO[r]}</strong></td>{SUMA[r].map((s) => <td>+{s}</td>)}</tr>)}
          <tr><td><strong>Extra de daño</strong></td>{EXTRA_DANO.map((s) => <td>+{s}</td>)}</tr>
        </tbody>
      </table>
      <h2>Suministros y descansos</h2>
      <ul class="fi-sumin-reglas">{SUMINISTROS.map((x) => <li><strong>{x.emoji} {x.nombre}.</strong> {x.regla}</li>)}<li><strong>⛺ Objeto de descanso.</strong> Cada héroe tiene uno propio: sirve para ambientar el descanso (¡el master puede darte alguna ventaja pequeña por usarlo bien!).</li></ul>
      <h2>Subir de nivel</h2>
      <p>Empiezas en <strong>nivel 1</strong> y subes <strong>un nivel al terminar cada aventura</strong> (o cuando el master diga). Mejoran tus números, tienes más vidas y, en los niveles 3 y 5, <strong>aprendes un poder nuevo</strong>. En el nivel 4 tu Defensa sube +1.</p>
    </div>

    {clases.map((c) => (
      <div class="fi-hoja" style={`--c:${c.color}`}>
        <div class="fi-cabecera">
          <div class="fi-cab-texto">
            <div class="hoja-cab">
              <span class="gran" aria-hidden="true">{c.emoji}</span>
              <div><h1>{c.nombre}</h1><p class="meta" style="margin:0">{c.rol} · “{c.frase}”</p></div>
            </div>
            <p>{c.resumen}</p>
            <p class="fi-nombre"><strong>Nombre del héroe:</strong> _______________________________</p>
            <p class="fi-nombre"><strong>Nivel:</strong> ______ &nbsp; <strong>💰 Dinero:</strong> {DINERO_TEXTO(c)} <small>(monedas de oro)</small></p>
          </div>
          {v === 'dibujo'
            ? <div class="fi-retrato fi-dibujo"><span>✏️ Dibuja aquí a tu héroe</span></div>
            : <img class="fi-retrato" src={`/fichas/heroes/${c.slug}-${v}.jpg`} alt={`${c.nombre} (${v})`} />}
        </div>

        <h2>Lo que sumas a cada dado <small class="meta">(tira un d20 y suma tu número)</small></h2>
        <table class="tabla-sencilla fi-niveles">
          <thead><tr><th>Nivel</th><th>❤️ Vidas</th><th>🛡️ Def.</th>{TALENTOS.map((t) => <th>{t.emoji} {t.nombre.slice(0, 3)}.</th>)}<th>Daño</th><th>Qué mejora</th></tr></thead>
          <tbody>
            {NIVELES.map((n) => (
              <tr>
                <td><strong>{n}</strong></td><td>{vida(c, n)}</td><td>{defensa(c, n)}</td>
                {TALENTOS.map((t) => <td>{mas(suma(c, t.id, n))}</td>)}
                <td>{mas(extraDano(n))}</td><td>{mejora[n - 1]}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Tus dos armas</h2>
        <div class="fi-armas">
          {c.armas.map((a) => {
            const tal = TALENTOS.find((t) => t.id === a.talento)!;
            return (
              <article class="arma">
                <h3>{a.emoji} {a.nombre}</h3>
                <p class="meta" style="margin:0">{a.alcance === 'cuerpo' ? 'cuerpo a cuerpo' : 'a distancia'} · usa {tal.emoji} {tal.nombre}</p>
                <p class="fi-tirada">1º Atacar: <strong>d20 +{ataqueArma(c, a, 1)}</strong> <small>(nivel 1)</small> · 2º Si aciertas: <strong>{a.dado} +{extraDano(1)}</strong></p>
                <p class="nota">{a.nota}</p>
                <p class="alcance">🎯 {alcanceTexto(a)}</p>
              </article>
            );
          })}
        </div>

        <h2>Tus poderes</h2>
        {c.poderes.map((p) => (
          <div class="poder">
            <span class="uso">Nivel {p.nivel} · {USO_TEXTO(p.uso, p.veces)}</span>
            <h3>{p.nombre}</h3>
            <p>{p.texto}</p>
          </div>
        ))}

        <h2>Tu equipo</h2>
        <ul class="equipo">{c.equipo.map((e) => <li class="eq">{equipoTexto(e)}</li>)}<li class="dinero">💰 {DINERO_TEXTO(c)} al empezar</li></ul>
        <h3>Suministros <small class="meta">(poción y descanso: mira las reglas)</small></h3>
        <ul class="equipo sumin">{SUMINISTROS.map((x) => <li>{x.emoji} {x.nombre}</li>)}<li class="desc">⛺ {c.descanso}</li></ul>
        <h3>Mis vidas <small class="meta">(tacha al perderlas)</small></h3>
        <div class="casillas">{Array.from({ length: Math.ceil(vida(c, 5) / 5) }).map((_, g) => <span class="g">{Array.from({ length: Math.min(5, vida(c, 5) - g * 5) }).map(() => <i />)}</span>)}</div>
      </div>
    ))}
  </section>
</Base>
