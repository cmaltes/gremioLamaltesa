---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const todas = await getCollection('aventuras');
  return todas.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content, headings } = await render(a);
const indice = headings.filter((h) => h.depth <= 3);
const PUBLICO = { ninos: 'Niños', adultos: 'Adultos', familia: 'Toda la familia' } as const;
const pdf = d.descargas.find((x) => x.tipo.toLowerCase() === 'pdf');
const ICONO: Record<string, string> = { pdf: '📄', imagen: '🖼️', audio: '🎵', zip: '📦', stl: '🧸' };
const secciones = [
  ['resumen', 'Resumen'], ['guion', 'Guion'],
  ...(d.mapas.length ? [['mapas', 'Mapas']] : []),
  ...(d.pnj.length ? [['personajes', 'Personajes']] : []),
  ...(d.ilustraciones.length ? [['escenas', 'Escenas']] : []),
  ...(d.musica.length ? [['musica', 'Música']] : []),
  ...(d.miniaturas.length ? [['miniaturas', 'Miniaturas']] : []),
  ['descargas', 'Descargas'],
];
const mini = (r: { archivo: string; miniatura?: string }) => r.miniatura ?? r.archivo;
---
<Base titulo={d.titulo} descripcion={d.resumen} imagen={d.portada} clase="aventura">
  <div class="portada"><img src={d.portada} alt="" width="1200" height="675"></div>
  <div class="cab">
    <p class="meta">{PUBLICO[d.publico]} · {d.edad}</p>
    <h1>{d.titulo}</h1>
    {d.subtitulo && <p class="lead" style="margin-bottom:0">{d.subtitulo}</p>}
    <dl class="ficha-datos">
      <div><dt>Nivel</dt><dd>{d.nivel}</dd></div>
      <div><dt>Jugadores</dt><dd>{d.jugadores}</dd></div>
      <div><dt>Duración</dt><dd>{d.duracion}</dd></div>
      <div><dt>Edad</dt><dd>{d.edad}</dd></div>
    </dl>
    <div class="fila no-imprimir">
      <a class="boton" href="#guion">Leer el guion</a>
      {pdf && <a class="boton fantasma" href={pdf.archivo} download>📄 Guion en PDF</a>}
    </div>
  </div>

  <nav class="pestanas no-imprimir" aria-label="Secciones de la aventura" style="margin-top:20px">
    <ul>{secciones.map(([id, nombre]) => <li><a href={`#${id}`}>{nombre}</a></li>)}</ul>
  </nav>

  <section id="resumen" class="seccion">
    <h2><span>🎪</span> Resumen</h2>
    <p class="lead">{d.resumen}</p>
    <p><strong>Ambientación:</strong> {d.ambientacion}</p>
    <div class="fila">{d.etiquetas.map((e) => <span class="etiqueta">{e}</span>)}</div>
    <p class="nota-reglas" style="margin-top:16px">🎲 <strong>Para jugar con las <a href="/fichas/">fichas del Gremio</a>:</strong> las habilidades de esta aventura (Fuerza, Destreza, Constitución, Inteligencia, Sabiduría y Carisma) son las mismas de las fichas. Dificultades (DC): 5 fácil, 10 normal, 15 difícil, 20 heroico.</p>
  </section>

  <section id="guion" class="seccion">
    <h2><span>📜</span> Guion</h2>
    <div class="barra-lector no-imprimir">
      <button class="chip" type="button" data-letra="-" aria-label="Letra más pequeña">A−</button>
      <button class="chip" type="button" data-letra="+" aria-label="Letra más grande">A+</button>
      <button class="chip" type="button" data-pantalla aria-pressed="false">☀️ Pantalla encendida</button>
      {pdf && <a class="chip" href={pdf.archivo} download>📄 PDF</a>}
    </div>
    <details class="indice no-imprimir">
      <summary>Índice del guion</summary>
      <ol>{indice.map((h) => <li class={`h${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
    <div class="guion"><Content /></div>
  </section>

  {d.mapas.length > 0 && (
    <section id="mapas" class="seccion">
      <h2><span>🗺️</span> Mapas</h2>
      <p class="meta">toca un mapa para verlo grande y hacer zoom</p>
      <div class="galeria">
        {d.mapas.map((m) => (
          <figure>
            <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"><span class="lupa">🔍 zoom</span></a>
            <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {d.pnj.length > 0 && (
    <section id="personajes" class="seccion">
      <h2><span>🧙</span> Personajes</h2>
      <div class="pnj">
        {d.pnj.map((p) => (
          <article>
            {p.imagen ? <img src={p.imagen} alt={p.nombre} loading="lazy" width="88" height="88"> : <div class="sin-foto" aria-hidden="true">👤</div>}
            <div><h3>{p.nombre}</h3><p class="rol">{p.rol}</p><p>{p.descripcion}</p></div>
          </article>
        ))}
      </div>
    </section>
  )}

  {d.ilustraciones.length > 0 && (
    <section id="escenas" class="seccion">
      <h2><span>🖼️</span> Escenas</h2>
      <p class="meta">enséñalas en la mesa cuando llegue la escena</p>
      <div class="galeria">
        {d.ilustraciones.map((m) => (
          <figure>
            <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"><span class="lupa">🔍</span></a>
            <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {d.musica.length > 0 && (
    <section id="musica" class="seccion">
      <h2><span>🎵</span> Música</h2>
      {d.musica.map((m) => (
        <div class="pista">
          <div class="pista-cab">
            {m.caratula ? <img src={m.caratula} alt="" width="72" height="72" loading="lazy"> : <div class="sin-foto" style="font-size:2rem;text-align:center">🎵</div>}
            <div><h3>{m.titulo}</h3>{m.cuando && <p>{m.cuando}</p>}</div>
          </div>
          <audio controls preload="none" src={m.archivo} data-titulo={m.titulo} data-caratula={m.caratula}></audio>
          {m.letra && (
            <details class="letra">
              <summary>Ver la letra</summary>
              {m.letra.map((e) => <p class="estrofa" set:html={e.replace(/\n/g, '<br>')} />)}
            </details>
          )}
          <a class="boton fantasma" href={m.archivo} download>⤓ Descargar MP3</a>
        </div>
      ))}
    </section>
  )}

  {d.miniaturas.length > 0 && (
    <section id="miniaturas" class="seccion">
      <h2><span>🧸</span> Miniaturas</h2>
      <div class="galeria">
        {d.miniaturas.map((m) => (
          <figure>
            <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"></a>
            <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section id="descargas" class="seccion">
    <h2><span>⤓</span> Descargas</h2>
    <ul class="descargas">
      {d.descargas.map((x) => (
        <li><a href={x.archivo} download><span class="ico">{ICONO[x.tipo.toLowerCase()] ?? '📎'}</span><span><strong>{x.titulo}</strong>{x.descripcion && <small>{x.descripcion}</small>}</span><span class="tipo">{x.tipo.toUpperCase()}</span></a></li>
      ))}
      {d.mapas.map((m) => (
        <li><a href={m.archivo} download><span class="ico">🗺️</span><span><strong>{m.titulo}</strong><small>Mapa para imprimir</small></span><span class="tipo">JPG</span></a></li>
      ))}
      {d.musica.map((m) => (
        <li><a href={m.archivo} download><span class="ico">🎵</span><span><strong>{m.titulo}</strong></span><span class="tipo">MP3</span></a></li>
      ))}
    </ul>
  </section>
</Base>
