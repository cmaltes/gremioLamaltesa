---
import Base from '../../layouts/Base.astro';
import { clases, porSlug, datos, textoPoder, DINERO_TEXTO, alcanceTexto, SUMINISTROS, equipoTexto, TALENTOS, NIVELES, RANGO_TEXTO, USO_TEXTO, suma, vida, defensa, extraDano, ataqueArma } from '../../data/clases';

export function getStaticPaths() { return clases.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const por = (f: (n: number) => string | number) => Object.fromEntries(NIVELES.map((n) => [`data-n${n}`, String(f(n))]));
const mejora = ['Empiezas tu aventura', '+1 de daño y más vidas', 'Nuevo poder y mejoran tus sumas', 'Defensa +1', 'Superpoder y mejoran tus sumas'];
const mas = (n: number) => `+${n}`;
const o = datos(c, 'chico');
const a = datos(c, 'chica');
---
<Base titulo={`${c.nombre}, ficha de héroe`} descripcion={`${c.nombre}: ${c.resumen} Ficha del nivel 1 al 5 con dos armas y los números que sumar en cada tirada.`} clase="fichas-pag">
  <section data-ficha={c.slug} style={`--c:${c.color}`}>
    <p class="meta no-imprimir"><a href="/fichas/">← todas las fichas</a></p>
    <div class="hoja-cab">
      <span class="gran" aria-hidden="true">{c.emoji}</span>
      <div>
        <h1><span data-t="chico">{o.nombre}</span><span data-t="chica" hidden>{a.nombre}</span></h1>
        <p class="meta" style="margin:0"><span data-t="chico">{o.rol} · “{o.frase}”</span><span data-t="chica" hidden>{a.rol} · “{a.frase}”</span></p>
      </div>
    </div>
    <div class="heroe-foto" data-heroe>
      <img class="on" src={`/fichas/heroes/${c.slug}-chico.jpg`} alt={`${c.nombre}, versión chico`} data-sexo="chico" width="640" height="800" />
      <img src={`/fichas/heroes/${c.slug}-chica.jpg`} alt={`${c.nombre}, versión chica`} data-sexo="chica" width="640" height="800" />
      <div class="sexo-sel no-imprimir" role="group" aria-label="Elige tu héroe">
        <button type="button" data-sexo-btn="chico" aria-pressed="true">🧑 Chico</button>
        <button type="button" data-sexo-btn="chica" aria-pressed="false">👩 Chica</button>
      </div>
    </div>
    <p><span data-t="chico">{o.resumen}</span><span data-t="chica" hidden>{a.resumen}</span></p>
    <p class="solo-imprimir"><strong>Nombre del héroe:</strong> ______________________________ <strong>Nivel:</strong> ____</p>

    <div class="nivel-sel" role="group" aria-label="Elige tu nivel">
      {NIVELES.map((n) => <button type="button" data-nivel={n} aria-pressed={n === 1 ? 'true' : 'false'}>Nivel {n}</button>)}
    </div>

    <div class="vitales">
      <div class="vital v"><span class="n" {...por((n) => vida(c, n))}>{vida(c, 1)}</span><span>❤️ Vidas</span></div>
      <div class="vital d"><span class="n" {...por((n) => defensa(c, n))}>{defensa(c, 1)}</span><span>🛡️ Defensa</span></div>
    </div>

    <h2>Lo que sumas a cada dado</h2>
    <p class="meta">tira un d20 y suma este número</p>
    <div class="numeros">
      {TALENTOS.map((t) => (
        <div class="num">
          <span class="e">{t.emoji}</span>
          <span class="t">{t.nombre}</span>
          <span class="n" {...por((n) => suma(c, t.id, n))}>{suma(c, t.id, 1)}</span>
          <small>{RANGO_TEXTO[c.talentos[t.id]]} · {t.sirve.split(',')[0].toLowerCase()}</small>
        </div>
      ))}
    </div>

    <h2 style="margin-top:28px">Tus dos armas</h2>
    <div class="armas">
      {c.armas.map((a) => {
        const tal = TALENTOS.find((t) => t.id === a.talento)!;
        return (
          <article class="arma">
            <h3>{a.emoji} {a.nombre}</h3>
            <p class="meta" style="margin:0">{a.alcance === 'cuerpo' ? 'cuerpo a cuerpo' : 'a distancia'} · usa {tal.emoji} {tal.nombre}</p>
            <div class="tirada">
              <div><small>1º Atacar</small><strong>d20 <b>+<span {...por((n) => ataqueArma(c, a, n))}>{ataqueArma(c, a, 1)}</span></b></strong></div>
              <div><small>2º Si aciertas</small><strong>{a.dado} <b>+<span {...por((n) => extraDano(n))}>{extraDano(1)}</span></b></strong></div>
            </div>
            <p class="nota">{a.nota}</p>
                <p class="alcance">🎯 {alcanceTexto(a)}</p>
          </article>
        );
      })}
    </div>

    <h2 style="margin-top:28px">Tus poderes</h2>
    {c.poderes.map((p) => (
      <div class="poder" data-desde={p.nivel}>
        <span class="uso">Nivel {p.nivel} · {USO_TEXTO(p.uso, p.veces)}</span>
        <h3>{p.nombre}</h3>
        <p><span data-t="chico">{p.texto}</span><span data-t="chica" hidden>{textoPoder(p.texto, 'chica')}</span></p>
      </div>
    ))}

    <h2 style="margin-top:28px">De nivel en nivel</h2>
    <div class="scroll-x">
      <table class="tabla-sencilla">
        <thead><tr><th>Nivel</th><th>Vidas</th><th>Def.</th>{TALENTOS.map((t) => <th>{t.emoji}</th>)}<th>Daño</th><th>Qué mejora</th></tr></thead>
        <tbody>
          {NIVELES.map((n) => (
            <tr data-fila={n}>
              <td>{n}</td><td>{vida(c, n)}</td><td>{defensa(c, n)}</td>
              {TALENTOS.map((t) => <td>{mas(suma(c, t.id, n))}</td>)}
              <td>{mas(extraDano(n))}</td><td style="min-width:200px">{mejora[n - 1]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 style="margin-top:28px">Tu equipo</h2>
    <ul class="equipo">{c.equipo.map((e) => <li class="eq">{equipoTexto(e)}</li>)}<li class="dinero">💰 {DINERO_TEXTO(c)} al empezar</li></ul>
    <h3 style="margin-top:14px">Suministros <small class="meta">(para curarte y descansar)</small></h3>
    <ul class="equipo sumin">
      {SUMINISTROS.map((x) => <li title={x.regla}>{x.emoji} {x.nombre}</li>)}
      <li class="desc">⛺ {c.descanso}</li>
    </ul>
    <p class="meta">{SUMINISTROS.map((x) => `${x.emoji} ${x.regla}`).join(' · ')}</p>

    <h3 style="margin-top:20px">Mis vidas <small class="meta">(tacha al perderlas)</small></h3>
    <div class="casillas solo-imprimir">{Array.from({ length: Math.ceil(vida(c, 5) / 5) }).map((_, g) => <span class="g">{Array.from({ length: Math.min(5, vida(c, 5) - g * 5) }).map(() => <i />)}</span>)}</div>

    <div class="fila no-imprimir" style="margin-top:24px">
      <button class="boton" type="button" data-imprimir>🖨️ Imprimir esta ficha</button>
      <a class="boton fantasma" href="/fichas/">Elegir otro héroe</a>
    </div>
    <p class="meta no-imprimir" style="margin-top:12px">Todas las fichas en PDF: <a href="/descargas/fichas-de-heroe-chico.pdf" download>chico</a> · <a href="/descargas/fichas-de-heroe-chica.pdf" download>chica</a> · <a href="/descargas/fichas-de-heroe-dibujo.pdf" download>para dibujar tú el héroe</a></p>
  </section>
</Base>

<script>
  // Chico o chica: cambia el retrato y se acuerda de la elección (solo en este navegador).
  const caja = document.querySelector<HTMLElement>('[data-heroe]');
  if (caja) {
    const poner = (sexo: string) => {
      caja.querySelectorAll<HTMLImageElement>('img[data-sexo]').forEach((i) => i.classList.toggle('on', i.dataset.sexo === sexo));
      caja.querySelectorAll<HTMLButtonElement>('[data-sexo-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sexoBtn === sexo)));
      document.querySelectorAll<HTMLElement>('[data-t]').forEach((e) => { e.hidden = e.dataset.t !== sexo; });
    };
    let guardado = 'chico';
    try { guardado = localStorage.getItem('gremio-sexo') || 'chico'; } catch {}
    poner(guardado);
    caja.querySelectorAll<HTMLButtonElement>('[data-sexo-btn]').forEach((b) => b.addEventListener('click', () => {
      poner(b.dataset.sexoBtn!);
      try { localStorage.setItem('gremio-sexo', b.dataset.sexoBtn!); } catch {}
    }));
  }
</script>
