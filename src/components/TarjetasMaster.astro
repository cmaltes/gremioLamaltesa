---
import type { Tarjeta } from '../data/pantalla';
interface Props { tarjetas: Tarjeta[] }
const { tarjetas } = Astro.props;
---
<div class="master-rejilla">
  {tarjetas.map((t) => (
    <section class="m-card">
      <h3>{t.emoji && <span aria-hidden="true">{t.emoji} </span>}{t.titulo}</h3>
      {t.filas.length > 0 && (
        <table>
          {t.cabecera && <thead><tr>{t.cabecera.map((h) => <th>{h}</th>)}</tr></thead>}
          <tbody>
            {t.filas.map((f) => <tr>{f.map((c, i) => (i === 0 && !t.cabecera ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}
          </tbody>
        </table>
      )}
      {t.notas.length > 0 && <ul>{t.notas.map((n) => <li>{n}</li>)}</ul>}
    </section>
  ))}
</div>
