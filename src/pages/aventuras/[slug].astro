---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const todas = await getCollection('aventuras');
  return todas.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content, headings } = await render(a);
const indice = headings.filter((h) => h.depth <= 3);
const PUBLICO = { ninos: 'Niños', adultos: 'Adultos', familia: 'Toda la familia' } as const;
const pdf = d.descargas.find((x) => x.tipo.toLowerCase() === 'pdf' && /guion/i.test(x.titulo));
const ICONO: Record<string, string> = { pdf: '📄', imagen: '🖼️', audio: '🎵', zip: '📦', stl: '🧸' };
const esHeroe = (r: { titulo: string }) => /héroes/i.test(r.titulo);
const fichasPdf = d.descargas.filter((x) => /fichas-de-heroe/.test(x.archivo));
const minisHeroes = d.miniaturas.filter(esHeroe);
const minisOtras = d.miniaturas.filter((m) => !esHeroe(m));
const hayHeroes = fichasPdf.length > 0 || minisHeroes.length > 0;
const hayGaleria = d.ilustraciones.length > 0 || minisOtras.length > 0;
const secciones = [
  ['resumen', 'Resumen'],
  ...(hayHeroes ? [['heroes', 'Héroes']] : []),
  ['guion', '🔒 Guía'],
  ...(d.pnj.length ? [['personajes', '🔒 Personajes']] : []),
  ...(d.mapas.length ? [['mapas', 'Mapas']] : []),
  ...(hayGaleria ? [['galeria', 'Galería']] : []),
  ...(d.musica.length ? [['musica', 'Música']] : []),
  ['descargas', 'Descargas'],
];
const gancho = d.gancho ?? d.resumen;
const mini = (r: { archivo: string; miniatura?: string }) => r.miniatura ?? r.archivo;
---
<Base titulo={d.titulo} descripcion={gancho} imagen={d.portada} clase="aventura">
  <div class="portada"><img src={d.portada} alt="" width="1200" height="675"></div>
  <div class="cab">
    <p class="meta">{PUBLICO[d.publico]} · {d.edad}</p>
    <h1>{d.titulo}</h1>
    {d.subtitulo && <p class="lead" style="margin-bottom:0">{d.subtitulo}</p>}
    <dl class="ficha-datos">
      <div><dt>Nivel</dt><dd>{d.nivel}</dd></div>
      <div><dt>Jugadores</dt><dd>{d.jugadores}</dd></div>
      <div><dt>Duración</dt><dd>{d.duracion}</dd></div>
      <div><dt>Edad</dt><dd>{d.edad}</dd></div>
    </dl>
  </div>

  <div class="pestanas-caja no-imprimir"><nav class="pestanas" aria-label="Secciones de la aventura" data-pestanas>
    <ul>{secciones.map(([id, nombre]) => <li><a href={`#${id}`}>{nombre}</a></li>)}</ul>
  </nav></div>

  <section id="resumen" class="seccion panel" data-panel>
    <h2><span>🎪</span> Resumen</h2>
    <p class="meta">sin spoilers: lo que se puede contar a los jugadores</p>
    <p class="lead">{gancho}</p>
    <div class="fila">{d.etiquetas.map((e) => <span class="etiqueta">{e}</span>)}</div>
    <p class="nota-reglas" style="margin-top:16px">🎲 <strong>Para jugar con las <a href="/fichas/">fichas del Gremio</a>:</strong> las habilidades de esta aventura (Fuerza, Destreza, Constitución, Inteligencia, Sabiduría y Carisma) son las mismas de las fichas. Dificultades (DC): 5 fácil, 10 normal, 15 difícil, 20 heroico.</p>
  </section>

  {hayHeroes && (
    <section id="heroes" class="seccion panel" data-panel>
      <h2><span>🛡️</span> Héroes</h2>
      <p class="lead">Elige a tu héroe antes de empezar: ficha, dibujo y muñeco de papel para la mesa.</p>
      <div class="fila"><a class="boton" href="/fichas/">Ver las fichas del Gremio</a></div>
      {fichasPdf.length > 0 && <>
        <h3>Fichas para imprimir</h3>
        <ul class="descargas">
          {fichasPdf.map((x) => <li><a href={x.archivo} download><span class="ico">📄</span><span><strong>{x.titulo}</strong>{x.descripcion && <small>{x.descripcion}</small>}</span><span class="tipo">PDF</span></a></li>)}
        </ul>
      </>}
      {minisHeroes.length > 0 && <>
        <h3>Muñecos y tokens de los héroes</h3>
        <div class="galeria">
          {minisHeroes.map((m) => (
            <figure>
              <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"></a>
              <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
            </figure>
          ))}
        </div>
      </>}
    </section>
  )}

  <section id="guion" class="seccion panel" data-panel data-master>
    <div class="puerta no-imprimir" hidden>
      <p class="puerta-ico" aria-hidden="true">🔒</p>
      <h2>Solo para el master</h2>
      <p>La guía cuenta la trama, quién es el villano y cómo se resuelven los acertijos. Si vas a jugar como héroe, mejor no mires.</p>
      <div class="fila"><button class="boton" type="button" data-soy-master>Soy el master, entrar</button><a class="boton fantasma" href="#resumen">Volver al resumen</a></div>
    </div>
    <div class="contenido-master">
    <h2><span>📜</span> Guía del master</h2>
    <p class="nota-reglas no-imprimir">⚠️ <strong>Con spoilers.</strong> Esta guía revela la trama, los villanos y las soluciones: léela tú antes de jugar y no se la enseñes a los jugadores.</p>
    <div class="barra-lector no-imprimir">
      <button class="chip" type="button" data-letra="-" aria-label="Letra más pequeña">A−</button>
      <button class="chip" type="button" data-letra="+" aria-label="Letra más grande">A+</button>
      <button class="chip" type="button" data-pantalla aria-pressed="false">☀️ Pantalla encendida</button>
      {pdf && <a class="chip" href={pdf.archivo} download>📄 PDF</a>}
      {d.pantalla.length > 0 && <a class="chip" href={`/aventuras/${a.id}/pantalla/`}>🖨️ Pantalla del master</a>}
    </div>
    <details class="indice no-imprimir">
      <summary>Índice del guion</summary>
      <ol>{indice.map((h) => <li class={`h${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
    <div class="guion"><Content /></div>
    </div>
  </section>

  {d.mapas.length > 0 && (
    <section id="mapas" class="seccion panel" data-panel>
      <h2><span>🗺️</span> Mapas</h2>
      <p class="meta">toca un mapa para verlo grande y hacer zoom</p>
      <div class="galeria">
        {d.mapas.map((m) => (
          <figure>
            <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"><span class="lupa">🔍 zoom</span></a>
            <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
            {m.casillas && (
              <p class="ficha-mapa">
                <b>{m.casillas} casillas · {m.tamano}</b> (1 casilla = 25 mm)
                {m.a4 && <a href={m.a4.archivo} download>⤓ A4 · {m.a4.hojas} hojas</a>}
                {m.a3 && <a href={m.a3.archivo} download>⤓ A3 · {m.a3.hojas} hojas</a>}
              </p>
            )}
          </figure>
        ))}
      </div>
    </section>
  )}

  {d.pnj.length > 0 && (
    <section id="personajes" class="seccion panel" data-panel data-master>
      <div class="puerta no-imprimir" hidden>
      <p class="puerta-ico" aria-hidden="true">🔒</p>
      <h2>Solo para el master</h2>
      <p>Aquí se dice quién es quién de verdad, y eso destripa la historia. Si vas a jugar como héroe, mejor no mires.</p>
      <div class="fila"><button class="boton" type="button" data-soy-master>Soy el master, entrar</button><a class="boton fantasma" href="#resumen">Volver al resumen</a></div>
    </div>
    <div class="contenido-master">
      <h2><span>🧙</span> Personajes</h2>
      <div class="pnj">
        {d.pnj.map((p) => (
          <article>
            {p.imagen ? <img src={p.imagen} alt={p.nombre} loading="lazy" width="88" height="88"> : <div class="sin-foto" aria-hidden="true">👤</div>}
            <div><h3>{p.nombre}</h3><p class="rol">{p.rol}</p><p>{p.descripcion}</p></div>
          </article>
        ))}
      </div>
      </div>
    </section>
  )}

  {hayGaleria && (
    <section id="galeria" class="seccion panel" data-panel>
      <h2><span>🖼️</span> Galería</h2>
      {d.ilustraciones.length > 0 && <>
        <h3>Escenas</h3>
        <p class="meta">enséñalas en la mesa cuando llegue la escena</p>
        <div class="galeria">
          {d.ilustraciones.map((m) => (
            <figure>
              <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"><span class="lupa">🔍</span></a>
              <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
            </figure>
          ))}
        </div>
      </>}
      {minisOtras.length > 0 && <>
        <h3>🧸 Miniaturas y tokens</h3>
        <div class="galeria">
          {minisOtras.map((m) => (
            <figure>
              <a class="ver" href={m.archivo} data-zoom data-titulo={m.titulo}><img src={mini(m)} alt={m.titulo} loading="lazy"></a>
              <figcaption><span>{m.titulo}{m.nota && <small>{m.nota}</small>}</span><a href={m.archivo} download aria-label={`Descargar ${m.titulo}`}>⤓</a></figcaption>
            </figure>
          ))}
        </div>
      </>}
    </section>
  )}

  {d.musica.length > 0 && (
    <section id="musica" class="seccion panel" data-panel>
      <h2><span>🎵</span> Música</h2>
      <p class="meta">la letra de la canción cuenta la trama: ¡no la leas a los jugadores antes de tiempo!</p>
      {d.musica.map((m) => (
        <div class="pista">
          <div class="pista-cab">
            {m.caratula ? <img src={m.caratula} alt="" width="72" height="72" loading="lazy"> : <div class="sin-foto" style="font-size:2rem;text-align:center">🎵</div>}
            <div><h3>{m.titulo}</h3>{m.cuando && <p>{m.cuando}</p>}</div>
          </div>
          <audio controls preload="none" src={m.archivo} data-titulo={m.titulo} data-caratula={m.caratula}></audio>
          {m.letra && (
            <details class="letra">
              <summary>Ver la letra</summary>
              {m.letra.map((e) => <p class="estrofa" set:html={e.replace(/\n/g, '<br>')} />)}
            </details>
          )}
          <a class="boton fantasma" href={m.archivo} download>⤓ Descargar MP3</a>
        </div>
      ))}
    </section>
  )}

  <section id="descargas" class="seccion panel" data-panel>
    <h2><span>⤓</span> Descargas</h2>
    <ul class="descargas">
      {d.descargas.map((x) => (
        <li><a href={x.archivo} download><span class="ico">{ICONO[x.tipo.toLowerCase()] ?? '📎'}</span><span><strong>{x.titulo}</strong>{x.descripcion && <small>{x.descripcion}</small>}</span><span class="tipo">{x.tipo.toUpperCase()}</span></a></li>
      ))}
      {d.mapas.map((m) => (
        <>
        <li><a href={m.archivo} download><span class="ico">🗺️</span><span><strong>{m.titulo}</strong><small>Mapa para imprimir</small></span><span class="tipo">JPG</span></a></li>
        {m.a4 && <li><a href={m.a4.archivo} download><span class="ico">🖨️</span><span><strong>{m.titulo} · A4</strong><small>{m.casillas} casillas a escala real (25 mm): {m.a4.hojas} hojas, con 1 casilla de solape</small></span><span class="tipo">PDF</span></a></li>}
        {m.a3 && <li><a href={m.a3.archivo} download><span class="ico">🖨️</span><span><strong>{m.titulo} · A3</strong><small>{m.casillas} casillas a escala real (25 mm): {m.a3.hojas} hojas, con 1 casilla de solape</small></span><span class="tipo">PDF</span></a></li>}
        </>
      ))}
      {d.musica.map((m) => (
        <li><a href={m.archivo} download><span class="ico">🎵</span><span><strong>{m.titulo}</strong></span><span class="tipo">MP3</span></a></li>
      ))}
    </ul>
  </section>
</Base>
